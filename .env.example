# LLM provider (Groq — free tier)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Remote sites — each is a separate router/POP. Defaults match the three
# mock router instances started by docker-compose.yml / the README's
# multi-terminal instructions. Add SITE_<NAME>_URL / SITE_<NAME>_TOKEN
# pairs in config/sites.py (or point SITES_CONFIG at a JSON file) to add
# real sites.
SITE_CBD_URL=http://localhost:8088
SITE_WESTLANDS_URL=http://localhost:8089
SITE_THIKA_ROAD_URL=http://localhost:8090
ROUTER_TIMEOUT_S=5

# Retrieval
RETRIEVAL_TOP_K=4

# Threat intelligence
# Optional — raises the NVD CVE API rate limit. Free: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=


# Audit log (defaults to ./audit_log.jsonl if unset)
AUDIT_LOG_PATH=

# Who confirmed write actions, for the audit log (defaults to OS username if unset)
TECHNICIAN_ID=
